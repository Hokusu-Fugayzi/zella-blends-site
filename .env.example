# Square — create an app at https://developer.squareup.com/apps
# Use sandbox credentials for staging, production credentials for live cutover
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Meta Pixel — Business Manager → Events Manager → your pixel
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# URL is auto-injected by Netlify in deploys; only set this for local dev
# URL=http://localhost:8888

# Anthropic (Claude) — powers the Bespoke Blend wizard at /api/recommend
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
